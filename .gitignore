# Local application state: admin credentials, JWT signing keys, uploaded company
# documents, generated demo files, and raw evaluation/customer data live here.
.local/
.test-runtime/

# Credential files are private even if copied outside .local/.
admin-credentials*
credentials.json
credentials.local.*
secrets.json
*.secrets.json
secrets/
credentials/
runtime.json

# Environment files and machine/deployment-specific settings.
.env
.env.*
**/appsettings.Local.json
**/appsettings.*.Local.json
**/appsettings.*.local.json
**/appsettings.Production.json
**/appsettings.Staging.json
*.PublishSettings
*.pubxml
*.pubxml.user
.npmrc.local
.pypirc
.netrc
_netrc

# Private keys, signing certificates, and copied cloud/SSH credentials.
*.key
*.pem
*.pfx
*.p12
*.p8
id_rsa
id_dsa
id_ecdsa
id_ed25519
.ssh/
.aws/
.azure/
.docker/
.kube/

# Uploaded documents and persisted service data must not become source files.
private-documents/
uploads/
/data/
/storage/
/backups/
/deploy/data/
/deploy/volumes/
/deploy/backups/
qdrant_storage/
sqlserver-data/
*.mdf
*.ndf
*.ldf
*.bak
*.bacpac
*.dump
*.sql.gz
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Downloaded local model weights and Ollama state.
.ollama/
/ollama-models/
*.gguf
*.safetensors

# Build output, dependencies, coverage, and temporary test/browser files.
**/bin/
**/obj/
**/node_modules/
**/dist/
**/TestResults/
**/playwright-report/
**/test-results/
**/coverage/
playwright/.auth/
.auth/
storageState.json
*.har
*.trx
*.coverage
*.coveragexml
*.tsbuildinfo
*.log
*.tmp
*.temp

# Editor and operating-system state.
.vs/
.idea/
*.user
*.suo
*.sln.docstates
*.swp
*.swo
~$*
.DS_Store
Thumbs.db
Desktop.ini

# Commit only sanitized examples. Keep shared appsettings, Docker configuration,
# source fixtures, SQL migrations, and package lockfiles under version control.
!.env.example
!.env.*.example
!appsettings*.json.example
!admin-credentials*.example
